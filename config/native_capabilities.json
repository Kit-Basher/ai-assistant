  "dispositions": [
    {"item":"ordinary grounded model chat","disposition":"supporting_internal","parent":"conversation.history","boundary":"Fallback only; it is not a tool capability."},
    {"item":"HTTP/Web UI static hosting","disposition":"supporting_internal","parent":"assistant.capabilities","boundary":"Transport surface, not a user goal."},
    {"item":"local control plane","disposition":"operator_only","parent":"operator.status","boundary":"Development/operator coordination only."},
    {"item":"arbitrary shell, Docker, Podman, or systemctl","disposition":"unsupported","parent":"system.shell.inspect","boundary":"Only allowlisted commands and bounded managed adapters are supported."},
    {"item":"Git push","disposition":"optional_unavailable","parent":"operator.lifecycle","boundary":"Classified preview-only; execution is disabled without explicit remote proof."},
    {"item":"foreign Python/JavaScript/native/shell plugin packs","disposition":"unsupported","parent":"packs.manage","boundary":"Portable text, declarative contracts, and isolated pure-computation Wasm are supported; arbitrary foreign host code is not."},
    {"item":"remote pack acquisition","disposition":"registered_native","parent":"packs.manage","boundary":"Supported exact HTTPS/GitHub sources require a separate authorization and stop at quarantine/review; no automatic approval, grants, enablement, or use."},
