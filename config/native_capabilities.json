    {"item":"desktop launcher and install/update/uninstall scripts","disposition":"operator_only","parent":"operator.lifecycle","boundary":"Single-install lifecycle boundary."},
    {"item":"backup, restore, support bundle, cleanup","disposition":"operator_only","parent":"operator.lifecycle","boundary":"Previewed and centrally confirmation-gated."},
    {"item":"provider configuration and secrets","disposition":"operator_only","parent":"models.inventory","boundary":"Loopback and mode/confirmation governed."},
    {"item":"notifications and autopilot ledgers","disposition":"supporting_internal","parent":"models.scout","boundary":"Controller observability, not separate normal-user capabilities."}
